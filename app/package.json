    "@codemirror/view": "^6.43.12",
    "@lezer/highlight": "^1.2.3",
    "@lucide/svelte": "^1.47.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2.7.3",
