{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rowly DB",
  "version": "0.4.1",
  "identifier": "com.khipudb.app",
  "mainBinaryName": "rowly-db",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Rowly DB",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../LICENSE": "licenses/LICENSE",
      "../../LICENSE-MIT": "licenses/LICENSE-MIT",
      "../../LICENSE-APACHE": "licenses/LICENSE-APACHE"
    },
    "category": "DeveloperTool",
    "shortDescription": "Free & Open Source SQL Client",
    "longDescription": "A lightweight desktop client for querying, exploring and understanding databases. 100% free, open source, no Pro edition.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3RjYxNDA1QTlDNDMxNkQKUldSdE1jU3BCUlQyOTZZVVJhTGZVSDVRZ3VhNEtqWHBFcmhWRDNub2R2RmQ1WklaMUlUSjBuZ2EK",
      "endpoints": [
        "https://github.com/anderson-andres-dev/rowly-db/releases/latest/download/latest.json"
      ]
    }
  }
}
